{
	"schemaVersion": 1,
	"id": "blocksmith",
	"version": "${version}",
	"name": "Blocksmith - Voxel Weapons",
	"description": "Create your custom weapons voxel by voxel with dynamic stats!",
	"authors": [
		"adeptfrog"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/dizonivan11/blocksmith"
	},
	"license": "MIT",
	"icon": "assets/blocksmith/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.adeptfrog.blocksmith.Blocksmith"
		],
		"client": [
			"net.adeptfrog.blocksmith.client.BlocksmithClient"
		],
		"fabric-datagen": [
			"net.adeptfrog.blocksmith.client.BlocksmithDataGenerator"
		],
		"modmenu": [
			"net.adeptfrog.blocksmith.client.compat.BlocksmithModMenu"
		]
	},
	"mixins": [
		"blocksmith.mixins.json",
		{
			"config": "blocksmith.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "blocksmith.client.version.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "${minecraft_dependency}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	}
}